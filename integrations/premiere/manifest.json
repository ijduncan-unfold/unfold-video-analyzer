{
  "manifestVersion": 5,
  "id": "com.ijduncan.video-analyzer.premiere",
  "name": "Video Analyzer",
  "version": "0.1.15",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.3.0" },
  "entrypoints": [
    {
      "id": "videoAnalyzerPanel",
      "type": "panel",
      "label": { "default": "Video Analyzer" },
      "minimumSize": { "width": 300, "height": 420 },
      "preferredDockedSize": { "width": 420, "height": 740 },
      "preferredFloatingSize": { "width": 480, "height": 740 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["http://localhost:8000", "https://localhost:8443"] },
    "localFileSystem": "fullAccess",
    "launchProcess": { "schemes": ["http", "https"], "extensions": [] }
  }
}
